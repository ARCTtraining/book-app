# Google Books API key, used server-side by /api/books.
#
# Get one at https://console.cloud.google.com: enable "Books API", create an
# API key, then restrict it to Books API only. Use a key of its own — a Maps
# key is normally HTTP-referrer restricted, and a server request sends no
# referrer.
#
# Never rename this to NEXT_PUBLIC_*: that prefix inlines the value into the
# browser bundle and publishes the key.
#
# Without it the app still runs, falling back to the bundled sample catalogue.
GOOGLE_BOOKS_API_KEY=

# --- Sync (optional) ---
# Shelf sync to MotherDuck. Leave these unset and the app works exactly as
# before: localStorage only, with the Sync section reporting it is not set up.

# MotherDuck service token. Full read/write on the database below, so treat it
# like a password. Create one at https://app.motherduck.com -> Settings.
MOTHERDUCK_TOKEN=

# Region-scoped Postgres endpoint. Defaults to us-east-1; check yours in the
# MotherDuck console if connections fail.
MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_DATABASE=book_app

# Shared secret guarding /api/sync. The deployment is public, so without this
# anyone with the URL could read or overwrite the shelf. Pick a long random
# string; you enter the same value once per device in Settings -> Sync.
SYNC_PASSPHRASE=
